{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "title": "Verdict",
  "description": "A flow's consolidated judgment about one candidate against one contract: which ladder levels ran, which envelopes it rests on, what remains open, and what it does not claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict_id",
    "run_id",
    "flow",
    "result",
    "dry_run",
    "decided_at",
    "contract_ref",
    "ladder_levels_run",
    "envelope_refs",
    "evidence",
    "criterion_results",
    "findings",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "workflows.verdict.v1" },
    "verdict_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "flow": { "$ref": "core.defs.schema.json#/$defs/flow_name" },
    "result": { "$ref": "core.defs.schema.json#/$defs/verdict_result" },
    "dry_run": { "type": "boolean" },
    "decided_at": { "$ref": "core.defs.schema.json#/$defs/timestamp" },
    "contract_ref": { "$ref": "core.defs.schema.json#/$defs/contract_ref" },
    "candidate": { "$ref": "core.defs.schema.json#/$defs/candidate" },
    "ladder_levels_run": {
      "description": "Which review-ladder levels actually ran. Levels that did not run must be named in non_claims rather than silently skipped.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "core.defs.schema.json#/$defs/ladder_level" }
    },
    "envelope_refs": {
      "description": "The envelopes this verdict consolidates.",
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "core.defs.schema.json#/$defs/identifier" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "core.defs.schema.json#/$defs/evidence_ref" }
    },
    "criterion_results": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "core.defs.schema.json#/$defs/criterion_outcome" }
    },
    "findings": {
      "description": "Every finding the flow produced, including resolved ones. A PASS verdict may not carry an OPEN finding of severity CRITICAL or HIGH; that rule is a semantic check, not a schema keyword.",
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "core.defs.schema.json#/$defs/finding" }
    },
    "non_claims": { "$ref": "core.defs.schema.json#/$defs/non_claims" },
    "telemetry_totals": { "$ref": "core.defs.schema.json#/$defs/token_usage" },
    "notes": { "type": "string", "maxLength": 8000 }
  }
}
