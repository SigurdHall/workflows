{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-contract.schema.json",
  "title": "Task contract",
  "description": "What must be done, for work with a deterministic oracle. Scope and protected paths are enforced by gates, never by prompt text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_revision",
    "contract_type",
    "goal",
    "scope",
    "protected",
    "acceptance",
    "verification"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "workflows.task-contract.v1" },
    "contract_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "contract_revision": { "type": "integer", "minimum": 1 },
    "contract_type": { "type": "string", "const": "task" },
    "goal": {
      "description": "One paragraph of intent: the why that survives edge cases. Long enough to decompose, short enough to read.",
      "type": "string",
      "minLength": 40,
      "maxLength": 4000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths"],
      "properties": {
        "allowed_paths": {
          "description": "The only paths a worker may change. Everything else is read-only.",
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "core.defs.schema.json#/$defs/path_pattern" }
        }
      }
    },
    "protected": {
      "description": "Paths that must remain byte-identical. Enforced by hash gates.",
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "core.defs.schema.json#/$defs/path_pattern" }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "verification": { "$ref": "#/$defs/verification" },
    "notes": { "type": "string", "maxLength": 4000 }
  },
  "$defs": {
    "criterion": {
      "title": "Acceptance criterion",
      "description": "A criterion a reviewer maps evidence to. Restating the goal is an anti-pattern; decompose it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
        "statement": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "negative_path": {
          "description": "True when the criterion asserts that something invalid is rejected. Such criteria require an executed probe as evidence.",
          "type": "boolean"
        }
      }
    },
    "verification": {
      "title": "Verification command",
      "description": "The exact command whose exit code is the primary oracle. Given as argv, never as a shell string, and never with a silent interpreter fallback: if the executable is missing the gate fails closed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "expect_exit_code"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "cwd": { "$ref": "core.defs.schema.json#/$defs/relative_path" },
        "expect_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}
