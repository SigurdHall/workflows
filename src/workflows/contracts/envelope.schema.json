{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Envelope",
  "description": "The machine-readable result of any step, and the only thing that crosses a step boundary. Generated by the driver from structured step output, never free-typed by a model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "run_id",
    "step_id",
    "step_kind",
    "status",
    "terminal",
    "result",
    "dry_run",
    "produced_at",
    "contract_ref",
    "evidence",
    "criterion_results",
    "findings",
    "non_claims",
    "side_effects"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "workflows.envelope.v1" },
    "envelope_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "step_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "step_kind": { "$ref": "core.defs.schema.json#/$defs/step_kind" },
    "status": {
      "description": "Whether the step ran to completion. Independent of what it concluded.",
      "$ref": "core.defs.schema.json#/$defs/status"
    },
    "terminal": {
      "description": "True when no further attempt of this step will be made.",
      "type": "boolean"
    },
    "result": {
      "description": "What the step concluded. A step can complete successfully and still conclude FAIL.",
      "$ref": "core.defs.schema.json#/$defs/criterion_result"
    },
    "dry_run": {
      "description": "True when no model was called. Required so that dry-run evidence can never be mistaken for live evidence.",
      "type": "boolean"
    },
    "produced_at": { "$ref": "core.defs.schema.json#/$defs/timestamp" },
    "contract_ref": { "$ref": "core.defs.schema.json#/$defs/contract_ref" },
    "candidate": { "$ref": "core.defs.schema.json#/$defs/candidate" },
    "lens_id": {
      "description": "The lens this step worked from, so findings can be attributed to lenses across runs.",
      "$ref": "core.defs.schema.json#/$defs/identifier"
    },
    "ladder_level": { "$ref": "core.defs.schema.json#/$defs/ladder_level" },
    "evidence": {
      "description": "Every piece of logged evidence this step produced. Findings and criterion results reference these by id.",
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "core.defs.schema.json#/$defs/evidence_ref" }
    },
    "criterion_results": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "core.defs.schema.json#/$defs/criterion_outcome" }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "core.defs.schema.json#/$defs/finding" }
    },
    "non_claims": { "$ref": "core.defs.schema.json#/$defs/non_claims" },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "core.defs.schema.json#/$defs/side_effect" }
    },
    "telemetry": { "$ref": "core.defs.schema.json#/$defs/telemetry" },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
