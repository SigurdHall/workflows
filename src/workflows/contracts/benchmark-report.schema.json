{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-report.schema.json",
  "title": "Benchmark report",
  "description": "Cost against detection, per matrix cell. This is the artifact that turns this repository's defaults — how many workers, which lenses, which ladder thresholds — from opinions into measurements. Recall is reported per defect class, because one aggregate number hides exactly the classes that escape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "dry_run",
    "started_at",
    "finished_at",
    "cells",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "workflows.benchmark-report.v1" },
    "corpus_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "dry_run": { "type": "boolean" },
    "started_at": { "$ref": "core.defs.schema.json#/$defs/timestamp" },
    "finished_at": { "$ref": "core.defs.schema.json#/$defs/timestamp" },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/cell" }
    },
    "non_claims": { "$ref": "core.defs.schema.json#/$defs/non_claims" }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "model",
        "effort",
        "worker_count",
        "score",
        "telemetry",
        "duration_ms"
      ],
      "properties": {
        "cell_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
        "model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "effort": { "type": "string", "minLength": 1, "maxLength": 40 },
        "worker_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "score": { "$ref": "#/$defs/score" },
        "telemetry": { "$ref": "core.defs.schema.json#/$defs/token_usage" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "score": {
      "description": "Recall is caught over present, never caught over planted. A defect the producing step removed was never offered to a reviewer, and counting it as a miss measures the worker rather than the review.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planted",
        "present",
        "removed",
        "indeterminate",
        "caught",
        "missed",
        "detected",
        "unmatched_findings",
        "by_class",
        "lens_yield"
      ],
      "properties": {
        "planted": { "type": "integer", "minimum": 0 },
        "present": {
          "description": "Planted defects a probe found still in the scored candidate. The only ones a reviewer could have caught, and so the only denominator recall may use.",
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "description": "Planted defects a probe found gone. The producing step fixed them; they are not reviewer misses.",
          "type": "integer",
          "minimum": 0
        },
        "indeterminate": {
          "description": "Planted defects whose presence no probe settled: none declared, or it did not answer. Reported, never folded into either side.",
          "type": "integer",
          "minimum": 0
        },
        "caught": {
          "description": "Present defects a finding pointed at. The numerator of recall.",
          "type": "integer",
          "minimum": 0
        },
        "missed": {
          "description": "Present defects no finding pointed at. The number this benchmark exists to drive down.",
          "type": "integer",
          "minimum": 0
        },
        "detected": {
          "description": "Planted defects a finding pointed at, whatever their presence state. Kept because it is what earlier reports recorded; read caught instead.",
          "type": "integer",
          "minimum": 0
        },
        "unmatched_findings": {
          "description": "Findings that match no planted defect. Deliberately not called false positives: an unmatched finding may be a real defect the corpus author did not plant.",
          "type": "integer",
          "minimum": 0
        },
        "by_class": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/class_score" }
        },
        "lens_yield": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/lens_score" }
        }
      }
    },
    "class_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defect_class",
        "class_name",
        "planted",
        "present",
        "removed",
        "indeterminate",
        "caught",
        "missed",
        "detected"
      ],
      "properties": {
        "defect_class": { "type": "integer", "minimum": 1, "maximum": 20 },
        "class_name": { "type": "string", "minLength": 3, "maxLength": 100 },
        "planted": { "type": "integer", "minimum": 0 },
        "present": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "indeterminate": { "type": "integer", "minimum": 0 },
        "caught": { "type": "integer", "minimum": 0 },
        "missed": { "type": "integer", "minimum": 0 },
        "detected": { "type": "integer", "minimum": 0 }
      }
    },
    "lens_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lens_id", "findings", "matched"],
      "properties": {
        "lens_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
        "findings": { "type": "integer", "minimum": 0 },
        "matched": {
          "description": "Findings from this lens that matched a planted defect. This is the join that lets lens sets be tuned on evidence.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
