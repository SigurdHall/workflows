{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-report.schema.json",
  "title": "Program report",
  "description": "One consolidated report per program: per-task verdicts, open findings, telemetry, and every stop in one place. This is the artifact a human reads after approving a plan, and it is the only thing they should have to read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_run_id",
    "plan_ref",
    "result",
    "dry_run",
    "started_at",
    "finished_at",
    "tasks",
    "telemetry_totals",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "workflows.program-report.v1" },
    "program_run_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
    "plan_ref": { "$ref": "#/$defs/plan_ref" },
    "result": { "$ref": "core.defs.schema.json#/$defs/verdict_result" },
    "dry_run": { "type": "boolean" },
    "started_at": { "$ref": "core.defs.schema.json#/$defs/timestamp" },
    "finished_at": { "$ref": "core.defs.schema.json#/$defs/timestamp" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/task_report" }
    },
    "telemetry_totals": { "$ref": "core.defs.schema.json#/$defs/token_usage" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "stops": {
      "description": "Every reason the program stopped short. An empty list means it ran to the end.",
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/stop" }
    },
    "non_claims": { "$ref": "core.defs.schema.json#/$defs/non_claims" }
  },
  "$defs": {
    "plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_revision", "digest"],
      "properties": {
        "plan_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "core.defs.schema.json#/$defs/digest" }
      }
    },
    "task_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "flow", "run_id", "state", "result", "open_findings"],
      "properties": {
        "task_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
        "flow": { "$ref": "core.defs.schema.json#/$defs/flow_name" },
        "run_id": { "$ref": "core.defs.schema.json#/$defs/identifier" },
        "state": { "$ref": "core.defs.schema.json#/$defs/step_state" },
        "result": { "$ref": "core.defs.schema.json#/$defs/verdict_result" },
        "verdict_ref": { "$ref": "core.defs.schema.json#/$defs/relative_path" },
        "open_findings": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "core.defs.schema.json#/$defs/finding" }
        },
        "telemetry": { "$ref": "core.defs.schema.json#/$defs/token_usage" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "wall_clock_seconds"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 1 },
        "wall_clock_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["token_budget", "wall_clock_budget", "escalation", "task_failure"]
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "task_id": { "$ref": "core.defs.schema.json#/$defs/identifier" }
      }
    }
  }
}
